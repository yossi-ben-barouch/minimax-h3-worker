# Required shared secret. Generate with: openssl rand -hex 32
MINIMAX_H3_WORKER_TOKEN=

# Supabase output uploader. Keep service-role credentials only on the worker.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OUTPUT_BUCKET=generation-outputs

# Optional for public MiniMaxAI/MiniMax-H3 downloads; recommended for rate limits.
HF_TOKEN=

# The mounted Network Volume contains the filtered Ref2VA checkpoint files.
MODELS_DIR=/runpod-volume/models
MINIMAX_H3_MODEL_DIR=/runpod-volume/models/minimax-h3

# Bump this with any released worker change. It is persisted in output diagnostics.
MINIMAX_H3_WORKER_BUILD=minimax-h3-ref2va-1
MINIMAX_H3_DEFAULT_STEPS=30
